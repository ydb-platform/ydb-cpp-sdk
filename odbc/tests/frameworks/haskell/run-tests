#!/usr/bin/env python3
import os,sys
from pathlib import Path
sys.path.insert(0,'/harness/bindings')
from adapter import run

def main(s):
    s.command(['runhaskell','Setup.hs','configure','--user','--prefix=/work/hdbc'], 'configure')
    s.command(['runhaskell','Setup.hs','build'], 'build')
    s.command(['runhaskell','Setup.hs','register','--inplace'], 'register')
    binary=Path('/work/hdbc-tests')
    s.command(['ghc','-outputdir','/work/hdbc-test-build','-i','-itestsrc','-package','HDBC-odbc',s.adapter/'report.hs','-o',binary], 'test-build')
    env={'YDB_HDBC_CONNECTION': ('DSN=' if s.mode=='dsn' else '')+s.connection}
    discovered=s.command([binary,'--list'],'inventory',env=env)
    names=[line.removeprefix('@YDB_INVENTORY\t') for line in discovered.stdout.splitlines() if line.startswith('@YDB_INVENTORY\t')]
    s.plan(names)
    result=s.command([binary],'upstream',env=env,check=False,timeout=1200)
    for line in result.stdout.splitlines():
        if line.startswith('@YDB_CASE\t'):
            _,name,status,filename=line.split('\t',3)
            path=s.native/filename
            s.add(name,status,path.read_text(),attachments=[path,s.native/'upstream.log'])

raise SystemExit(run(main))
