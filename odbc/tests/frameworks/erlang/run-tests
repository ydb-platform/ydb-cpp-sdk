#!/usr/bin/env python3
import os,sys
from pathlib import Path
sys.path.insert(0,'/harness/bindings')
from adapter import run

def main(s):
    directory=s.source/'lib/odbc/test'
    s.command(['erlc','-W0',*sorted(directory.glob('*.erl')),s.adapter/'ydb_report.erl'],'compile',cwd=directory)
    env={'YDB_ERLANG_CONNECTION':('DSN=' if s.mode=='dsn' else '')+s.connection,
         'YDB_ERLANG_TEST_DIR':str(directory)}
    cmd=['erl','+S','2','-noshell','-pa',directory,'-s','ydb_report','main']
    listing=s.command(cmd,'inventory',env=env|{'ODBC_DISCOVER_ONLY':'1'})
    names=[line.split('\t',1)[1] for line in listing.stdout.splitlines() if line.startswith('@YDB_INVENTORY\t')]
    s.plan(names)
    s.command(cmd,'upstream',env=env,check=False,timeout=1200)
    import xml.etree.ElementTree as ET
    path=s.native/'ct.xml'
    cases=list(ET.parse(path).getroot().iter('testcase'))
    # Common Test also reports successful lifecycle callbacks; keep errors fatal.
    for case in cases:
        if case.get('name','').startswith(('init_per_','end_per_')) and any(child.tag in {'error','failure'} for child in case):
            s.add('infrastructure','broken',ET.tostring(case,encoding='unicode'),phase='setup')
    tree=ET.parse(path)
    for suite in tree.getroot().iter('testsuite'):
        for case in list(suite):
            if case.tag=='testcase': case.set('classname',suite.get('name',''))
            if case.tag=='testcase' and case.get('name','').startswith(('init_per_','end_per_')):suite.remove(case)
    tree.write(path)
    s.junit(path,names,name_of=lambda c:c.get('classname','').split('.')[0]+'.'+c.get('name',''),log=s.native/'upstream.log')

raise SystemExit(run(main))
