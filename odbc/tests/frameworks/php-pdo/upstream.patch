+static int odbc_stmt_get_col(pdo_stmt_t *stmt, int colno, zval *result, enum pdo_param_type *type)
+{
+	pdo_odbc_stmt *S = (pdo_odbc_stmt*)stmt->driver_data;
+	pdo_odbc_column *C = &S->cols[colno];
+	if (!C->is_long) {
+		return odbc_stmt_get_col_uncached(stmt, colno, result, type);
+	}
+	if (Z_ISUNDEF(C->cached_value) && !odbc_stmt_get_col_uncached(stmt, colno, &C->cached_value, type)) {
+		return 0;
+	}
+	ZVAL_COPY(result, &C->cached_value);
+	return 1;
+}
