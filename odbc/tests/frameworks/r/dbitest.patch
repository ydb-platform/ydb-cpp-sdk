+# Keep the fixture payload unchanged; use a separate key for roundtrips with
+# duplicate values, NULL rows or types that cannot be YDB primary keys.
+ydb_keyed_fixture <- function(value) {
+  value$ydb_fixture_id <- seq_len(nrow(value))
+  value
+}
+
+ydb_field_types <- function(con, value, field.types = NULL, row.names = NULL) {
+  value <- sqlRownamesToColumn(value, row.names = row.names)
+  keys <- if ("ydb_fixture_id" %in% names(value)) "ydb_fixture_id" else names(value)[vapply(value, function(column)
+    (is.integer(column) || is.character(column)) && !anyDuplicated(column), logical(1))]
+  stopifnot(length(keys) > 0L)
+  types <- field.types
+  if (is.null(types)) {
+    types <- dbDataType(con, value)
+    types[vapply(value, inherits, logical(1), "integer64")] <- "BIGINT"
+  }
+  # Preserve partial field.types: omitted payload columns still exercise inference.
+  if (!keys[1] %in% names(types)) types[keys[1]] <- dbDataType(con, value[[keys[1]]])
+  aliases <- c("BIT" = "Bool", "DOUBLE PRECISION" = "Double", "VARCHAR(255)" = "Utf8",
+               "VARBINARY(255)" = "String", "DATE" = "Date32", "TIMESTAMP" = "Timestamp64", "TIME" = "Datetime")
+  mapped <- aliases[types]
+  types[!is.na(mapped)] <- mapped[!is.na(mapped)]
+  types[length(types)] <- paste0(types[length(types)], ", PRIMARY KEY (",
+                                dbQuoteIdentifier(con, keys[1]), ")")
+  types
+}
