@@ -0,0 +1,58 @@
+#' @include dbi-connection.R
+NULL
+
+setClass("YDB", contains = "OdbcConnection")
+
+#' @export
+odbcDataType.YDB <- function(con, obj, ...) {
+  switch_type(obj,
+    factor = "Utf8", datetime = "Timestamp64", date = "Date32",
+    time = "Datetime", binary = "String", integer = "Int32", int64 = "Int64",
+    double = "Double", character = "Utf8", logical = "Bool", list = "Utf8",
+    stop("Unsupported type", call. = FALSE)
+  )
+}
+
+for (type in c("list", "blob")) setMethod("dbQuoteLiteral", c("YDB", type), function(conn, x, ...) {
+  SQL(sub("^[xX]'([0-9a-fA-F]*)'$", "String::HexDecode('\\1's)", callNextMethod()))
+})
+setMethod("dbQuoteLiteral", c("YDB", "Date"), function(conn, x, ...) {
+  SQL(ifelse(is.na(x), "NULL", paste0("Date32('", format(x, "%Y-%m-%d"), "'s)")))
+})
+setMethod("dbQuoteLiteral", c("YDB", "POSIXct"), function(conn, x, ...) {
+  SQL(ifelse(is.na(x), "NULL", paste0("Timestamp64('", format(x, "%Y-%m-%dT%H:%M:%OS6", tz="UTC"), "Z's)")))
+})
+setMethod("dbQuoteLiteral", c("YDB", "difftime"), function(conn, x, ...) {
+  SQL(ifelse(is.na(x), "NULL", paste0("Datetime('1970-01-01T", format(hms::as_hms(x)), "Z's)")))
+})
+
+setMethod("dbListFields", c("YDB", "SQL"), function(conn, name, ...) {
+  dbListFields(conn, dbUnquoteIdentifier(conn, name)[[1]], ...)
+})
+setMethod("dbRemoveTable", c("YDB", "character"), function(conn, name, ..., fail_if_missing = TRUE) {
+  stopifnot(is.logical(fail_if_missing), length(fail_if_missing) == 1L, !is.na(fail_if_missing))
+  dbExecute(conn, paste("DROP TABLE", if (!fail_if_missing) "IF EXISTS", dbQuoteIdentifier(conn, name)))
+  invisible(TRUE)
+})
+
+setMethod("dbQuoteLiteral", c("YDB", "POSIXlt"), function(conn, x, ...) {
+  dbQuoteLiteral(conn, as.POSIXct(x), ...)
+})
+setMethod("dbListTables", "YDB", function(conn, ..., table_type = "'TABLE','VIEW','COLUMN_TABLE'") {
+  callNextMethod(conn, ..., table_type = table_type)
+})
+setMethod("dbUnquoteIdentifier", c("YDB", "SQL"), function(conn, x, ...) {
+  lapply(callNextMethod(), function(id) {
+    if (length(id@name) == 1L) names(id@name) <- "table"
+    id
+  })
+})
+
+setMethod("sqlCreateTable", "YDB", function(con, table, fields, row.names = NA, temporary = FALSE, ..., primary_key = NULL) {
+  sql <- callNextMethod(con, table, fields, row.names = row.names, temporary = temporary, ...)
+  if (length(primary_key)) {
+    key <- paste(dbQuoteIdentifier(con, primary_key), collapse = ", ")
+    sql <- SQL(sub("\\)\\n$", paste0(", PRIMARY KEY (", key, "))\n"), sql))
+  }
+  sql
+})
