#!/usr/bin/env python3
import json,os,sys
from pathlib import Path
sys.path.insert(0,'/harness/bindings')
from adapter import run

def main(s):
    s.command(['perl','Makefile.PL','-u','-o','/usr'],'configure',env={'PERL_MM_USE_DEFAULT':'1'})
    s.command(['make','-j2'],'build')
    paths=sorted(p for p in (s.source/'t').glob('*.t') if p.name not in {'pod.t','pod-coverage.t'})
    s.plan([p.name for p in paths])
    env={'DBI_DSN':'dbi:ODBC:'+s.connection,'DBI_USER':'','DBI_PASS':'','PERL_DL_NONLAZY':'1',
         'PERL5LIB':str(s.source/'blib/lib')+':'+str(s.source/'blib/arch')}
    for path in paths:
        result=s.command(['perl','-I','t',s.adapter/'report.pl',path],path.name,env=env,check=False,timeout=120)
        report=s.native/(path.name+'.json')
        if not report.exists():
            s.add(path.name,'broken','TAP parser did not produce a result',attachments=[s.native/(path.name+'.log')]);continue
        data=json.loads(report.read_text())
        s.add(path.name,data['status'],data.get('message',''),attachments=[s.native/(path.name+'.log')],problems=data.get('problems'),rows=data.get('rows'))

raise SystemExit(run(main))
