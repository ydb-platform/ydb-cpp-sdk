#!/usr/bin/env python3
import os,sys,re,shutil
from pathlib import Path
sys.path.insert(0,'/harness/bindings')
from adapter import run

def main(s):
    s.command(['make','odbc','LUA_SYS_VER=5.4'], 'build')
    module=Path('/work/modules/luasql');module.mkdir(parents=True)
    shutil.copyfile(s.source/'src/odbc.so',module/'odbc.so')
    env={'LUA_CPATH':'/work/modules/?.so;;'}
    cmd=['lua5.4','tests/test.lua','odbc',s.connection]
    inventory=s.command(cmd,'inventory',env=env|{'ODBC_DISCOVER_ONLY':'1'}).stdout
    names=[line.split('\t',1)[1] for line in inventory.splitlines() if line.startswith('@YDB_INVENTORY\t')]
    s.plan(names)
    result=s.command(cmd,'upstream',env=env,check=False)
    for line in result.stdout.splitlines():
        if line.startswith('@YDB_CASE\t'):
            _,name,status,diagnostic=line.split('\t',3)
            s.add(name,status,bytes.fromhex(diagnostic).decode('utf-8',errors='replace'),attachments=[s.native/'upstream.log'])

raise SystemExit(run(main))
