#!/usr/bin/env python3
import os,sys,re,shutil
from pathlib import Path
sys.path.insert(0,'/harness/bindings')
from adapter import run

def main(s):
    s.command(['make','odbc','LUA_SYS_VER=5.4','CC=gcc -g'], 'build')
    module=Path('/work/modules/luasql');module.mkdir(parents=True)
    shutil.copyfile(s.source/'src/odbc.so',module/'odbc.so')
    env={'LUA_CPATH':'/work/modules/?.so;;'}
    cmd=['lua5.4','tests/test.lua','odbc',s.connection]
    inventory=s.command(cmd,'inventory',env=env|{'ODBC_DISCOVER_ONLY':'1'}).stdout
    names=[line.split('\t',1)[1] for line in inventory.splitlines() if line.startswith('@YDB_INVENTORY\t')]
    s.plan(names)
    for index,name in enumerate(names):
        result=s.command(['gdb','--batch','-ex','run','-ex','bt','--args',*cmd],
                         f'upstream-{index}',env=env|{'ODBC_TEST_CASE':name},check=False)
        if re.search(r'\breceived signal SIG[A-Z0-9]+\b', result.stdout):
            s.add(name,'failed',result.stdout,attachments=[s.native/f'upstream-{index}.log'])
            continue
        for line in result.stdout.splitlines():
            if line.startswith('@YDB_CASE\t'):
                _,case,status,diagnostic=line.split('\t',3)
                s.add(case,status,bytes.fromhex(diagnostic).decode('utf-8',errors='replace'),
                      attachments=[s.native/f'upstream-{index}.log'])

raise SystemExit(run(main))
