{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "displayName": "CPM-first generic configuration",
      "description": "Fetch pinned libraries through CPM; CPM_SOURCE_CACHE may point at a reusable or offline cache.",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "YDB_SDK_DEPENDENCY_MODE": "CPM"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "release-base",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-base",
      "inherits": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-toolchain",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "gcc-toolchain",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "test",
      "hidden": true,
      "cacheVariables": {
        "YDB_SDK_TESTS": "TRUE",
        "YDB_SDK_EXAMPLES": "TRUE",
        "ARCADIA_ROOT": "..",
        "ARCADIA_BUILD_ROOT": "."
      }
    },
    {
      "name": "release-clang",
      "inherits": ["release-base", "clang-toolchain"],
      "displayName": "CPM Release (Clang)"
    },
    {
      "name": "package-deb-clang",
      "inherits": ["release-base", "clang-toolchain"],
      "displayName": "Ubuntu 24.04 CPack DEB (system libraries)",
      "description": "Build all four SDK DEB components against Ubuntu package dependencies.",
      "binaryDir": "${sourceDir}/build-deb",
      "cacheVariables": {
        "YDB_SDK_INSTALL": "ON",
        "YDB_SDK_ENABLE_OTEL_METRICS": "ON",
        "YDB_SDK_ENABLE_OTEL_TRACE": "ON",
        "YDB_SDK_EXAMPLES": "OFF",
        "YDB_SDK_TESTS": "OFF",
        "YDB_SDK_DEPENDENCY_MODE": "SYSTEM",
        "BUILD_SHARED_LIBS": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr/share/yandex",
        "CMAKE_PREFIX_PATH": "/usr/share/yandex",
        "CMAKE_EXE_LINKER_FLAGS": "",
        "CMAKE_SHARED_LINKER_FLAGS": ""
      }
    },
    {
      "name": "release-gcc",
      "inherits": ["release-base", "gcc-toolchain"],
      "displayName": "CPM Release (GCC)"
    },
    {
      "name": "release-test-clang",
      "inherits": ["release-base", "clang-toolchain", "test"],
      "displayName": "CPM Release with all tests and examples (Clang)"
    },
    {
      "name": "release-test-gcc",
      "inherits": ["release-base", "gcc-toolchain", "test"],
      "displayName": "CPM Release with all tests and examples (GCC)"
    },
    {
      "name": "debug-clang",
      "inherits": ["debug-base", "clang-toolchain"],
      "displayName": "CPM Debug (Clang)"
    },
    {
      "name": "debug-gcc",
      "inherits": ["debug-base", "gcc-toolchain"],
      "displayName": "CPM Debug (GCC)"
    },
    {
      "name": "debug-test-clang",
      "inherits": ["debug-base", "clang-toolchain", "test"],
      "displayName": "CPM Debug with all tests and examples (Clang)"
    },
    {
      "name": "debug-test-gcc",
      "inherits": ["debug-base", "gcc-toolchain", "test"],
      "displayName": "CPM Debug with all tests and examples (GCC)"
    },
    {
      "name": "coverage-base",
      "inherits": ["release-base", "test"],
      "hidden": true,
      "cacheVariables": {
        "YDB_SDK_COVERAGE": "ON",
        "ARCADIA_ROOT": "${sourceDir}",
        "ARCADIA_BUILD_ROOT": "${sourceDir}/build"
      }
    },
    {
      "name": "coverage-test-gcc",
      "inherits": ["coverage-base", "gcc-toolchain"],
      "displayName": "CPM coverage with all tests and examples (GCC)"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "displayName": "Default Build",
      "configurePreset": "base"
    }
  ],
  "testPresets": [
    {
      "name": "common",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "timeout": 600
      }
    },
    {
      "name": "all",
      "inherits": "common",
      "displayName": "Run All Tests",
      "configurePreset": "base",
      "environment": {
        "YDB_ENDPOINT": "localhost:2136",
        "YDB_DATABASE": "/local"
      }
    },
    {
      "name": "unit",
      "inherits": "common",
      "displayName": "Run Unit Tests",
      "configurePreset": "base",
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "integration",
      "inherits": "common",
      "displayName": "Run Integration Tests",
      "configurePreset": "base",
      "filter": {
        "include": {
          "label": "integration"
        }
      },
      "environment": {
        "YDB_ENDPOINT": "localhost:2136",
        "YDB_DATABASE": "/local"
      }
    },
    {
      "name": "coverage-all",
      "inherits": "all",
      "displayName": "Run All Tests (coverage CI)",
      "configurePreset": "coverage-test-gcc",
      "execution": {
        "timeout": 1800
      },
      "filter": {
        "exclude": {
          "name": "(ManyMessages|DiscoveryHang|DescribeHang)"
        }
      },
      "environment": {
        "YDB_ENDPOINT": "localhost:2136",
        "YDB_DATABASE": "/local",
        "YDB_VERSION": "24.4"
      }
    }
  ]
}
