set(YDB-CPP-SDK_AVAILABLE_COMPONENTS @YDB-CPP-SDK_AVAILABLE_COMPONENTS@)
set(YDB-CPP-SDK_COMPONENT_TARGETS @YDB-CPP-SDK_COMPONENT_TARGETS@)

set(_ydb_sdk_package_name "${CMAKE_FIND_PACKAGE_NAME}")
set(_ydb_sdk_find_components "${${_ydb_sdk_package_name}_FIND_COMPONENTS}")

if (NOT _ydb_sdk_find_components)
  list(LENGTH YDB-CPP-SDK_AVAILABLE_COMPONENTS _ydb_sdk_component_count)
  if (_ydb_sdk_component_count GREATER 0)
    math(EXPR _ydb_sdk_last_component "${_ydb_sdk_component_count} - 1")
    foreach(_ydb_sdk_component_id RANGE ${_ydb_sdk_last_component})
      list(GET YDB-CPP-SDK_COMPONENT_TARGETS ${_ydb_sdk_component_id} _ydb_sdk_target)
      if (_ydb_sdk_target STREQUAL "libydb-cpp")
        list(GET YDB-CPP-SDK_AVAILABLE_COMPONENTS ${_ydb_sdk_component_id} _ydb_sdk_component)
        list(APPEND _ydb_sdk_find_components ${_ydb_sdk_component})
      endif()
    endforeach()
  endif()
endif()

list(REMOVE_DUPLICATES _ydb_sdk_find_components)

set(_ydb_sdk_needs_iam FALSE)
set(_ydb_sdk_needs_otel_metrics FALSE)
set(_ydb_sdk_needs_otel_tracing FALSE)

foreach(_ydb_sdk_component IN LISTS _ydb_sdk_find_components)
  list(FIND YDB-CPP-SDK_AVAILABLE_COMPONENTS ${_ydb_sdk_component} _ydb_sdk_component_id)
  if (_ydb_sdk_component_id EQUAL -1)
    message(FATAL_ERROR "${_ydb_sdk_component} is not available component")
  endif()

  list(GET YDB-CPP-SDK_COMPONENT_TARGETS ${_ydb_sdk_component_id} _ydb_sdk_target)
  if (_ydb_sdk_target STREQUAL "ydb-cpp-iam")
    set(_ydb_sdk_needs_iam TRUE)
  elseif (_ydb_sdk_target STREQUAL "ydb-cpp-otel-metrics")
    set(_ydb_sdk_needs_otel_metrics TRUE)
  elseif (_ydb_sdk_target STREQUAL "ydb-cpp-otel-tracing")
    set(_ydb_sdk_needs_otel_tracing TRUE)
  endif()
endforeach()

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/Modules")

find_package(IDN REQUIRED)
find_package(Iconv REQUIRED)
find_package(OpenSSL REQUIRED)
find_package(Protobuf CONFIG QUIET)
if (NOT Protobuf_FOUND)
  find_package(Protobuf MODULE REQUIRED)
endif()
find_package(gRPC REQUIRED)
find_package(ZLIB REQUIRED)
find_package(xxHash REQUIRED)
find_package(ZSTD REQUIRED)
find_package(BZip2 REQUIRED)
find_package(LZ4 REQUIRED)
find_package(Snappy 1.1.8 REQUIRED)
find_package(base64 REQUIRED)
find_package(Brotli 1.1.0 REQUIRED)
find_package(jwt-cpp REQUIRED)
find_package(GTest REQUIRED)
find_package(double-conversion REQUIRED)

if (@YDB_SDK_USE_SYSTEM_GOOGLEAPIS@)
  find_package(yandex-googleapis-api-common-protos REQUIRED)
endif()

if (@YDB_SDK_USE_RAPID_JSON@)
  find_package(RapidJSON REQUIRED)

  add_library(RapidJSON::RapidJSON INTERFACE IMPORTED)

  target_include_directories(RapidJSON::RapidJSON INTERFACE
    ${RAPIDJSON_INCLUDE_DIRS}
  )
endif()

if (@YDB_SDK_ENABLE_OTEL_METRICS@ OR @YDB_SDK_ENABLE_OTEL_TRACE@)
  if (_ydb_sdk_needs_otel_metrics OR _ydb_sdk_needs_otel_tracing)
    get_filename_component(_ydb_sdk_cmake_lib_dir "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
    list(APPEND CMAKE_PREFIX_PATH "${_ydb_sdk_cmake_lib_dir}")
    find_package(opentelemetry-cpp CONFIG REQUIRED)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/release/ydb-cpp-sdk-core-targets.cmake")
if (_ydb_sdk_needs_iam)
  include("${CMAKE_CURRENT_LIST_DIR}/release/ydb-cpp-sdk-iam-targets.cmake")
endif()
if (_ydb_sdk_needs_otel_metrics)
  include("${CMAKE_CURRENT_LIST_DIR}/release/ydb-cpp-sdk-otel-metrics-targets.cmake")
endif()
if (_ydb_sdk_needs_otel_tracing)
  include("${CMAKE_CURRENT_LIST_DIR}/release/ydb-cpp-sdk-otel-tracing-targets.cmake")
endif()

function(_find_ydb_sdk_component CompName)
  list(FIND YDB-CPP-SDK_AVAILABLE_COMPONENTS ${CompName} CompId)
  if (CompId EQUAL -1)
    message(FATAL_ERROR "${CompName} is not available component")
  endif()
  list(GET YDB-CPP-SDK_COMPONENT_TARGETS ${CompId} Tgt)
  add_library(YDB-CPP-SDK::${CompName} ALIAS YDB-CPP-SDK::${Tgt})
  set(${_ydb_sdk_package_name}_${CompName}_FOUND TRUE PARENT_SCOPE)
endfunction()

message(STATUS "YDB SDK components: ${_ydb_sdk_find_components}")

foreach(ITEM_COMPONENT IN LISTS _ydb_sdk_find_components)
  _find_ydb_sdk_component(${ITEM_COMPONENT})
endforeach()

@PACKAGE_INIT@

check_required_components(${_ydb_sdk_package_name})
